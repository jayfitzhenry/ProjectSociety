{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/infra/*", "statusCode": 404 },
    { "route": "/docs/*", "statusCode": 404 },
    { "route": "/.github/*", "statusCode": 404 },
    { "route": "/CLAUDE.md", "statusCode": 404 },
    { "route": "/checklist.md", "statusCode": 404 }
  ],
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".md": "text/markdown; charset=utf-8"
  }
}
